---
const { title } = Astro.props;
import '../styles/global.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Energy Ledger</title>
    <meta name="description" content="Energy systems make claims. Energy Ledger explores how those claims can be proven." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <nav style="background: #0c3530; padding: 0 2rem;">
      <div style="max-width: 860px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; height: 60px;">
        <a href="/" style="font-weight: 700; font-size: 1rem; text-decoration: none; color: #ffffff; letter-spacing: 0.05em;">Energy Ledger</a>
        <div style="display: flex; gap: 2rem;">
          <a href="/learn" style="color: #a8d5c8; text-decoration: none; font-size: 0.9rem;">Learn</a>
          <a href="/about" style="color: #a8d5c8; text-decoration: none; font-size: 0.9rem;">About</a>
        </div>
      </div>
    </nav>

    <main style="max-width: 860px; margin: 0 auto; padding: 3rem 2rem;">
      <slot />
    </main>

    <footer style="background: #0c3530; margin-top: 4rem; padding: 2rem;">
      <div style="max-width: 860px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; color: #a8d5c8; font-size: 0.85rem;">
        <span>Energy Ledger · energyledger.net</span>
        <a href="https://github.com/energyledgernet" style="color: #3abf99; text-decoration: none;">Open Source on GitHub</a>
      </div>
    </footer>
  </body>
</html>